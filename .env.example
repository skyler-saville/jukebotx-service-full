# Environment
ENV=development
LOG_LEVEL=INFO

# Compose
COMPOSE_PROJECT_NAME=jukebotx_${ENV}
COMPOSE_FILE=docker-compose.yml:docker-compose.${ENV}.yml

# Host ports per environment (override if needed)
DB_PORT_HOST_DEV=5432
API_PORT_HOST_DEV=8001
MINIO_PORT_HOST_DEV=9000
MINIO_CONSOLE_PORT_HOST_DEV=9001
LAVALINK_PORT_HOST_DEV=2333
DB_PORT_HOST_PROD=15432
API_PORT_HOST_PROD=18001
MINIO_PORT_HOST_PROD=19000
MINIO_CONSOLE_PORT_HOST_PROD=19001

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=jukebotx
POSTGRES_USER=jukebotx
POSTGRES_PASSWORD=password

DATABASE_URL=postgresql+asyncpg://jukebotx:jukebotx@db:5432/jukebotx

# Discord
DEV_DISCORD_TOKEN=000111000111000111
DISCORD_TOKEN=0001110001111000001111
DISCORD_GUILD_ID=123456789012345678
WEB_BASE_URL=https://jukebotx.cortocast.com
PUBLIC_ACTIVITY_CLIENT_ID=123456789012345678
OPUS_API_BASE_URL=http://api:8000
VOICE_BACKEND=lavalink

# Lavalink (required when VOICE_BACKEND=lavalink)
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_JAVA_OPTIONS=-Xmx1G
LAVALINK_SECURE=false
# Optional: stable session id for Lavalink resume support
LAVALINK_SESSION_ID=
# Optional: resume timeout (seconds) for Lavalink session recovery
LAVALINK_RESUME_TIMEOUT_SECONDS=

# Public Routing
PUBLIC_API_BASE_URL=https://jukebotx-api.example.com
PUBLIC_FRONTEND_URL=https://example.com


# API
API_HOST=0.0.0.0
API_PORT=8000
API_SESSION_SECRET=secret_token
API_SESSION_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=https://jukebotx.example.com,https://discord.com
OPUS_CACHE_DIR=static/opus
OPUS_CACHE_TTL_SECONDS=604800
OPUS_STORAGE_PROVIDER=s3
OPUS_STORAGE_BUCKET=jukebotx-opus
OPUS_STORAGE_PREFIX=opus
OPUS_STORAGE_REGION=us-east-1
OPUS_STORAGE_ENDPOINT_URL=http://minio:9000
OPUS_STORAGE_ACCESS_KEY_ID=secret_token
OPUS_STORAGE_SECRET_ACCESS_KEY=secret_key
OPUS_STORAGE_PUBLIC_BASE_URL=
OPUS_STORAGE_SIGNED_URL_TTL_SECONDS=900
OPUS_STORAGE_TTL_SECONDS=604800
MEDIA_BACKFILL_ENABLED=false
MEDIA_BACKFILL_POLL_SECONDS=30
MEDIA_BACKFILL_MIN_TRACK_AGE_SECONDS=600
MEDIA_BACKFILL_BROWSER_TIMEOUT_SECONDS=25
MEDIA_BACKFILL_USER_AGENT=jukebotx-media-worker/1.0
MEDIA_GIF_ENABLED=true
MEDIA_GIF_POLL_SECONDS=45
MEDIA_GIF_MIN_TRACK_AGE_SECONDS=600
MEDIA_GIF_FFMPEG_PATH=ffmpeg
MEDIA_GIF_FPS=10
MEDIA_GIF_WIDTH=512
MEDIA_GIF_STORAGE_PREFIX=media/gif

# Discord OAuth (API)
DISCORD_OAUTH_CLIENT_ID=01234567890123456789
DISCORD_OAUTH_CLIENT_SECRET=secret_token
DISCORD_OAUTH_REDIRECT_URI=https://jukebotx-api.example.com/auth/discord/callback

# Api generated URL
DISCORD_GENERATED_URL=secret_url

# Discord OAuth (Activity)
DISCORD_ACTIVITY_CLIENT_ID=01234567890123456789
DISCORD_ACTIVITY_CLIENT_SECRET=secret_token
DISCORD_ACTIVITY_REDIRECT_URI=https://jukebotx.example.com

# SUNO Test URL
SUNO_SMOKE_URL=some_suno_song_url
PLAYLIST_SMOKE_URL=some_suno_playlist_url
