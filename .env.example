# Environment
ENV=development
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=jukebotx
POSTGRES_USER=jukebotx
POSTGRES_PASSWORD=password

DATABASE_URL=postgresql+asyncpg://jukebotx:jukebotx@db:5432/jukebotx

# Discord
DEV_DISCORD_TOKEN=000111000111000111
DISCORD_TOKEN=0001110001111000001111
DISCORD_GUILD_ID=123456789012345678
WEB_BASE_URL=https://jukebotx.cortocast.com
PUBLIC_ACTIVITY_CLIENT_ID=123456789012345678
OPUS_API_BASE_URL=http://api:8000

# Cloudflare Tunnel
CLOUDFLARED_TOKEN=secret_token
CLOUDFLARED_API_TOKEN=secret_token
PUBLIC_API_BASE_URL=https://api.example.com


# API
API_HOST=0.0.0.0
API_PORT=8000
API_SESSION_SECRET=secret_token
API_SESSION_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=https://jukebotx.example.com,https://discord.com
OPUS_CACHE_DIR=static/opus
OPUS_CACHE_TTL_SECONDS=604800
OPUS_STORAGE_PROVIDER=s3
OPUS_STORAGE_BUCKET=jukebotx-opus
OPUS_STORAGE_PREFIX=opus
OPUS_STORAGE_REGION=us-east-1
OPUS_STORAGE_ENDPOINT_URL=http://minio:9000
OPUS_STORAGE_ACCESS_KEY_ID=secret_token
OPUS_STORAGE_SECRET_ACCESS_KEY=secret_key
OPUS_STORAGE_PUBLIC_BASE_URL=
OPUS_STORAGE_SIGNED_URL_TTL_SECONDS=900
OPUS_STORAGE_TTL_SECONDS=604800

# Discord OAuth (API)
DISCORD_OAUTH_CLIENT_ID=01234567890123456789
DISCORD_OAUTH_CLIENT_SECRET=secret_token
DISCORD_OAUTH_REDIRECT_URI=https://api.example.com/auth/discord/callback

# Api generated URL
DISCORD_GENERATED_URL=secret_url

# Discord OAuth (Activity)
DISCORD_ACTIVITY_CLIENT_ID=01234567890123456789
DISCORD_ACTIVITY_CLIENT_SECRET=secret_token
DISCORD_ACTIVITY_REDIRECT_URI=https://jukebotx.example.com

# SUNO Test URL
SUNO_SMOKE_URL=some_suno_song_url
PLAYLIST_SMOKE_URL=some_suno_playlist_url
